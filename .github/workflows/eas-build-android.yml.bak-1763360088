name: EAS Build — Android AAB (with inputs)

on:
  push:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      web_app_url:
        description: 'Web app URL (optional)'
        required: false
        default: ''
      app_name:
        description: 'App display name (expo.name)'
        required: true
        default: 'My App'
      application_id:
        description: 'Android package id (com.example.myapp)'
        required: true
        default: 'com.example.myapp'
      version_name:
        description: 'App version (expo.version) e.g. 1.0.0'
        required: true
        default: '1.0.0'
      icon_url:
        description: 'App icon URL (1024x1024 PNG)'
        required: false
        default: ''
      splash_image_url:
        description: 'Splash screen image URL (1242x2436 PNG)'
        required: false
        default: ''

env:
  # If your Expo project is in a subfolder, set this to that folder name (e.g. "expo-app")
  PROJECT_PATH: '.'
  UPLOAD_TO_S3: 'false' # change to "true" if you want S3 upload enabled

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ${{ env.PROJECT_PATH }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Cache npm
        id: cache-npm
        uses: actions/cache@v4
        with:
          path: ~/.npm
          # use package-lock.json hash for a stable, reliable cache key
          key: node-modules-${{ runner.os }}-${{ hashFiles('**/package-lock.json') }}
          restore-keys: |
            node-modules-${{ runner.os }}-
        continue-on-error: true

      - name: Setup Expo
        uses: expo/expo-github-action@v7
        with:
          packager: 'npm'
          expo-version: latest
          eas-version: latest
          token: ${{ secrets.EXPO_TOKEN }}

      - name: Install dependencies
        run: |
          npm ci

      - name: Ensure EAS project is initialized
        run: npx eas-cli@latest init --non-interactive --force

      - name: Run EAS build
        run: npx eas-cli@latest build --platform android --profile production --non-interactive

      - name: (Optional) Download build artifact & Upload to S3 (non-fatal)
        if: env.UPLOAD_TO_S3 == 'true'
        env:
          EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          AWS_REGION: ${{ secrets.AWS_REGION }}
          S3_BUCKET: ${{ secrets.S3_BUCKET }}
        run: |
          set -e
          # find last finished build id (best-effort)
          BUILD_ID=$(npx eas-cli@latest build:list --platform android --limit 1 --status finished --json | jq -r '.[0].id' || true)
          if [ -z "$BUILD_ID" ] || [ "$BUILD_ID" = "null" ]; then
            echo "No finished builds found; skipping S3 upload."
            exit 0
          fi
          echo "Found build id: $BUILD_ID"
          ARTIFACT_URL=$(npx eas-cli@latest build:view $BUILD_ID --json | jq -r '.artifacts.buildUrl // empty' || true)
          if [ -z "$ARTIFACT_URL" ]; then
            echo "No artifact URL found for build $BUILD_ID; skipping S3 upload."
            exit 0
          fi
          echo "Downloading artifact from: $ARTIFACT_URL"
          curl -fL -o app.aab "$ARTIFACT_URL" || { echo "Download failed; skipping S3 upload."; exit 0; }
          echo "Uploading to s3..."
          aws configure set region "$AWS_REGION"
          aws s3 cp app.aab "s3://$S3_BUCKET/expo-artifacts/$GITHUB_RUN_ID-app.aab" || echo "S3 upload failed (non-fatal)."
        continue-on-error: true
